@model SistemaGestionInventario.Models.Categoria

@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1>Eliminar categoría</h1>
<h5 class="text-danger">¿Está seguro de que desea eliminar esta categoría?</h5>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<form asp-action="Delete" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn"
            style="background-color: #F8DEDF; color: #914B51; border: 1px solid #EFC4C7; border-radius: 8px;">
        Eliminar
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;">
        Volver a la lista
    </a>
</form>