@model SistemaGestionInventario.Models.Categoria

@{
    ViewData["Title"] = "Crear categoría";
}

<h1>Crear categoría</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn"
                        style="background-color: #E6DDF5; color: #5B4580; border: 1px solid #D2C3EC; border-radius: 8px;">
                    Guardar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;">
                    Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}