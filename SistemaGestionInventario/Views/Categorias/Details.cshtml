@model SistemaGestionInventario.Models.Categoria

@{
    ViewData["Title"] = "Detalle de categoría";
}

<h1>Detalle de categoría</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn"
       style="background-color: #DCE8FA; color: #385780; border: 1px solid #C3D5F0; border-radius: 8px;">
        Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;">
        Volver a la lista
    </a>
</div>